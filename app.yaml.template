# QueryForge AI - Databricks App Configuration Template
# Copy this file to app.yaml and fill in the values for your environment
#
# For multiple environments, create:
#   - app.yaml.dev   (development)
#   - app.yaml.prod  (production)
# Then deploy with: python deploy_to_databricks.py --config app.yaml.dev

# Deployment metadata (used by deploy_to_databricks.py, removed before deployment)
deployment:
  app_name: "<YOUR_APP_NAME>"           # e.g., "queryforge-dev" or "queryforge-prod"
  profile: "<YOUR_DATABRICKS_PROFILE>"  # e.g., "fe-ai" (from ~/.databrickscfg)

command: ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]

# Allow anonymous access to the app
default_source_ip_permissions:
  - action: ALLOW
    ip_addresses: ["0.0.0.0/0"]

env:
  - name: ENV
    value: "production"
  - name: PORT
    value: "8000"
  - name: DEBUG
    value: "False"

  # Databricks Connection
  - name: DATABRICKS_HOST
    value: "<YOUR_DATABRICKS_HOST>"           # e.g., "https://your-workspace.cloud.databricks.com"
  - name: DATABRICKS_TOKEN
    valueFrom: "<YOUR_SCOPE>/databricks-token"  # Secret scope/key for PAT token
  - name: DATABRICKS_CATALOG
    value: "<YOUR_CATALOG>"                   # Unity Catalog name
  - name: DATABRICKS_SCHEMA
    value: "<YOUR_SCHEMA>"                    # Default schema
  - name: DATABRICKS_HTTP_PATH
    value: "<YOUR_SQL_WAREHOUSE_PATH>"        # e.g., "/sql/1.0/warehouses/abc123"

  # Application Settings
  - name: REQUIREMENTS_TABLE
    value: "saved_requirements"               # Table for storing saved requirements
